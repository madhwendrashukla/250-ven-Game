{
  "name": "rs250-venture",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite --port 5173 --strictPort\" \"tsx watch server/index.ts --port 8787\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts --port 8787",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:vercel": "tsc --noEmit && node scripts/build-vercel.mjs",
    "deploy": "npm run build:vercel && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "express": "^4.21.2",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "postgres": "3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.6.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "0.25.12",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
